# Skopiuj do .env. Domyślna konfiguracja wymaga tylko klucza Gemini (darmowy).

# LLM domyślny: Gemini (darmowy klucz: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=


# Opcjonalny tracing: LangSmith (darmowy plan dla jednej osoby)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kovalo-copilot

# Opcjonalny tryb zgodny z kursem (OpenAI, płatny)
OPENAI_API_KEY=

# Postgres (docker-compose)
POSTGRES_USER=kovalo
POSTGRES_PASSWORD=kovalo
POSTGRES_DB=kovalo
