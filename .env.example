# Skopiuj do .env. Domyślna konfiguracja wymaga tylko klucza Gemini (darmowy).

# LLM domyślny: Gemini (darmowy klucz: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=


# Opcjonalny tracing: LangSmith (darmowy plan dla jednej osoby)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kovalo-copilot

# Opcjonalny tryb zgodny z kursem (OpenAI, płatny)
OPENAI_API_KEY=

# Postgres (docker-compose)
POSTGRES_USER=kovalo
POSTGRES_PASSWORD=kovalo
POSTGRES_DB=kovalo

# Opcjonalnie: port api po stronie hosta (docker compose; domyślnie 8080)
# API_PORT=8080

# Opcjonalnie: inna ścieżka config.yaml
# KOVALO_CONFIG_FILE=
# Uwaga: KOVALO_DB__HOST, KOVALO_SERVICES__API_URL i KOVALO_SERVICES__MCP_URL ustawia
# docker-compose.yml (nazwy hostów w sieci compose), nie wpisuj ich tutaj.
