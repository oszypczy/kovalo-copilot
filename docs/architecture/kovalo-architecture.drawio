Color=page;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="cli" target="srv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2" value="Ewaluacja E5 (kovalo eval e5) i E4 przez MCP" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="500" height="24" as="geometry"/></mxCell><mxCell id="gold" value="&lt;b&gt;wzorzec: 13 rozmów, 25 tur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mini_project_5_conversations.yaml (C1–C5)&lt;br&gt;+ dialogi MP3 D1–D8&lt;br&gt;+ nakładka mp3_overlays (D7)&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="220" height="100" as="geometry"/></mxCell><mxCell id="par" value="&lt;b&gt;zgodność (zawsze, 0 LLM-a)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;compare_call: bezpośrednio vs MCP&lt;br&gt;20 wywołań (17 kursu + 3 nasze)&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="550" width="260" height="80" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;odtworzenie (zawsze, 0 LLM-a)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;idealne understand, agent ze skryptu&lt;br&gt;przez prawdziwy serwer MCP&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="650" width="260" height="80" as="geometry"/></mxCell><mxCell id="live" value="&lt;b&gt;na żywo (--live)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;understand + agent przez MCP&lt;br&gt;JsonFileLlmCache, --cache-only bez klucza&lt;br&gt;--max-calls 40: wspólny, liczy błędy&lt;br&gt;serwer: stdio lokalnie, http w compose&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="750" width="260" height="90" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;score_assistant_turn (port kursu)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;12 wymiarów według oczekiwanej ścieżki&lt;br&gt;tury o dane: score_trace z E4&lt;br&gt;tura „skipped” zostaje w mianowniku&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="270" height="100" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;raport&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reports/mp5/&lt;data&gt;-e5.md + .json&lt;br&gt;assistant_run.replay.json · .live.json&lt;br&gt;review.yaml (przegląd ręczny)&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="640" width="270" height="100" as="geometry"/></mxCell><mxCell id="e4mcp" value="&lt;b&gt;E4 przez MCP (U9)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kovalo eval e4 --live --transport stdio&lt;br&gt;--cache-only: trafienia z F4, 0 wywołań&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="770" width="270" height="80" as="geometry"/></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="1" source="gold" target="par"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="gold" target="rep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="gold" target="li