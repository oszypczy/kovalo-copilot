    </diagram>
    <diagram id="workflow-f3" name="5. Workflow F3: API, UI, E3"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="820" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Workflow F3: rozmowa, pauzy, checkpointy i ewaluacja E3&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="sec1" value="Aplikacja (docker compose)" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="300" height="24" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;ui: Chainlit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;klient httpx, JSON&lt;br&gt;bez pauzy: tekst → /messages&lt;br&gt;w pauzie: tekst → /resume {text}&lt;br&gt;przyciski cl.Action → /resume {value, pause_ref}&lt;br&gt;źródła: cl.Text z treścią chunku&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="220" height="120" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;api: FastAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /threads&lt;br&gt;POST /threads/{id}/messages&lt;br&gt;POST /threads/{id}/resume&lt;br&gt;GET /threads/{id}&lt;br&gt;409 thread_paused · not_paused · stale_pause&lt;br&gt;thread_busy · thread_stuck&lt;br&gt;422 invalid_request · 503 copilot_unavailable&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="240" height="160" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;CopilotService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;send_message · resume · get_thread&lt;br&gt;strażnik pauzy, jedna tura na wątek&lt;br&gt;text_pl.human_answer („7,5”, „zatwierdź”)&lt;br&gt;→ TurnResult (odpowiedzi, pauza, wniosek, źródła, tokeny)&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="250" height="140" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;graf copilota&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;build_copilot_graph(CopilotDeps)&lt;br&gt;understand → route → … → clarify ⟲ / decide → approve ⟲&lt;br&gt;invoke(version=&quot;v2&quot;, durability=&quot;sync&quot;)&lt;br&gt;(strona 2)&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="230" height="140" as="geometry"/></mxCell><mxCell id="und" value="&lt;b&gt;understand_model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;get_structured_model(Turn, &quot;understand&quot;), prompt understand_system (PINNED)&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1260" y="60" width="200" height="70" as="geometry"/></mxCell><mxCell id="doc" value="&lt;b&gt;document_answerer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LazyDocumentAnswerer → RAG F2 (open_retriever + Answer)&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1260" y="150" width="200" height="60" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;policy.required_approvers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;course-v1, Decimal, bez LLM-a&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1260" y="230" width="200" height="60" as="geometry"/></mxCell><mxCell id="gem" value="Gemini API&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flash-Lite → Flash&lt;/font&gt;" style="ellipse;shape=cloud;fillColor=#ffffff;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="110" height="70" as="geometry"/></mxCell><mxCell id="pgv" value="pgvector&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kovalo_ctx&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=10;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="80" height="70" as="geometry"/></mxCell><mxCell id="saver" value="&lt;b&gt;postgres: PostgresSaver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ConnectionPool, serializer z Turn / DiscountRequest / Decision&lt;br&gt;checkpoints · checkpoint_writes · checkpoint_blobs&lt;br&gt;pauza przetrwa restart api&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="955" y="270" width="240" height="110" as="geometry"/></mxCell><mxCell id="e1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="svc" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="graph" target="saver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="graph" target="und"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="graph" target="doc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="graph" target="pol"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="und" target="gem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="doc" target="pgv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sec2" value="Ewaluacja E3 (kovalo eval e3)" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="300" height="24" as="geometry"/></mxCell><mxCell id="dlg" value="&lt;b&gt;dialogi D1–D8&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;13 tur: user, idealny understand, resume, expect (wzorzec ręczny)&lt;br&gt;data/eval/mini_project_3_dialogues.yaml&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="220" height="90" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;odtworzenie (zawsze)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ScriptedUnderstanding (idealny Turn)&lt;br&gt;RAG offline: embeddingi z cache kursu&lt;br&gt;InMemorySaver · 0 wywołań LLM-a · cel 100%&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="460" width="240" height="90" as="geometry"/></mxCell><mxCell id="live" value="&lt;b&gt;na żywo (--live)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;get_structured_model(Turn) + JsonFileLlmCache&lt;br&gt;13 understand + 1 odpowiedź RAG = 14&lt;br&gt;--cache-only: offline, 0 wywołań, bez klucza&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="580" width="240" height="90" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;run_turn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;port helpers.workflow.run_turn na CopilotService; skrypt odpowiada na pauzy; nieudana pauza → cancel, reszta dialogu pominięta&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="525" width="250" height="90" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;score_transcript&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kierowanie · pola · wniosek · zatwierdzający · pauzy · status&lt;br&gt;wzorzec ręczny, nie nasz silnik (test oracle)&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="525" width="230" height="90" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;raport&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reports/mp3/&amp;lt;data&amp;gt;-e3.md + .json&lt;br&gt;dialogues.replay.json · dialogues.live.json&lt;br&gt;review.yaml (przegląd ręczny)&lt;br&gt;obok referencji kursu 13/13 … 0 błędów&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1260" y="520" width="220" height="100" as="geometry"/></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="dlg" target="rep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="dlg" target="live"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="rep" target="run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="live" target="run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="transkrypt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="run" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="score" target="out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f7" value="ta sama ścieżka co API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;defaultLabelBackgroundColor=page;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="run" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Kolor = kto decyduje&lt;/b&gt;&lt;br&gt;niebieski: LLM · zielony: zwykły kod · pomarańczowy: stan pauzy (checkpointy) · szary: wejście/wyjście, transport" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="800" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
    <diagram id="agent-f4" name="6. Agent F4: narzędzia, trace, SSE, E4"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="930" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Agent F4: narzędzia, trace, strumień SSE i ewaluacja E4&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="s1" value="Tura z agentem (docker compose)" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="400" height="24" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;ui: Chainlit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;httpx-sse: POST …/messages/stream&lt;br&gt;tool_start → cl.Step (type=tool)&lt;br&gt;tool_end → wynik kroku (brief)&lt;br&gt;final → odpowiedź, pauza, źródła&lt;br&gt;krok „Ścieżka dowodowa”&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="220" height="140" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;api: FastAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /threads/{id}/messages/stream&lt;br&gt;POST /threads/{id}/resume/stream&lt;br&gt;GET /threads/{id}/trace&lt;br&gt;StreamingResponse text/event-stream, ping 15 s&lt;br&gt;błędy przed strumieniem: JSON 409/422/503&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="250" height="150" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;CopilotService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;start_message → TurnStream&lt;br&gt;tura w wątku roboczym (executor):&lt;br&gt;dobiega do końca po rozłączeniu&lt;br&gt;TurnEvent: tool_start · tool_end · final · error&lt;br&gt;get_trace · utrata Postgresa → 503&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="630" y="80" width="250" height="150" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;graf copilota: answer_documents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;understand: assistant_understand_system&lt;br&gt;agent(standalone, on_event)&lt;br&gt;on_event → get_stream_writer (custom)&lt;br&gt;odpowiedź albo przeprosiny, status&lt;br&gt;record = koperta agent_trace v1&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="250" height="150" as="geometry"/></mxCell><mxCell id="runner" value="&lt;b&gt;AgentRunner (create_agent)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;run_question: Budget 24 kroki / 180 s (PINNED)&lt;br&gt;prompt agent_system (PINNED), bez pamięci&lt;br&gt;middleware: tool_errors → fallback (tylko błędy dostępności)&lt;br&gt;→ CallMeter (E4) → StableUsage&lt;br&gt;checkpointer=False, pusty kontekst&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1250" y="60" width="290" height="170" as="geometry"/></mxCell><mxCell id="gem" value="&lt;b&gt;Gemini API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flash-Lite → Flash&lt;/font&gt;" style="ellipse;shape=cloud;fillColor=#ffffff;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1570" y="80" width="110" height="70" as="geometry"/></mxCell><mxCell id="saver" value="&lt;b&gt;postgres: checkpointy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;record: agent_trace (trace_id, created_at)&lt;br&gt;GET /trace: ostatnia koperta z historii stanu&lt;br&gt;trace przetrwa restart api&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="290" width="250" height="110" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;tools/: 7 narzędzi tylko do odczytu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ToolSpec: funkcja z adnotacjami + rekord Pydantic&lt;br&gt;LangChain StructuredTool (F4) · FastMCP (F5)&lt;br&gt;6 kursu + check_termination_condition&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1250" y="280" width="290" height="110" as="geometry"/></mxCell><mxCell id="comp" value="&lt;b&gt;company/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;odczyty OTIF / faktur / warunków&lt;br&gt;kara: Decimal, grosze, HALF_UP&lt;br&gt;warunek rozwiązania (CON-101: &amp;lt; 94% × 3)&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1250" y="430" width="140" height="120" as="geometry"/></mxCell><mxCell id="srch" value="&lt;b&gt;search + policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;search_documents (top_k 3)&lt;br&gt;check_discount_policy&lt;br&gt;(required_approvers)&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1400" y="430" width="140" height="120" as="geometry"/></mxCell><mxCell id="pgv" value="&lt;b&gt;pgvector&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kovalo_ctx&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=10;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1580" y="440" width="90" height="80" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;dane (tylko odczyt)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;data/company/*&lt;br&gt;config: company.termination_terms&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1250" y="580" width="290" height="60" as="geometry"/></mxCell><mxCell id="e1" value="SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="stream:&lt;br&gt;custom,&lt;br&gt;updates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=10;" edge="1" parent="1" source="svc" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="graph" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="runner" target="gem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="wywołania narzędzi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="runner" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="graph" target="saver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="get_trace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" 