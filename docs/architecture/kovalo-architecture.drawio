<mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="refs" target="resc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="refs" target="repl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="resc" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="repl" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="live" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="goldb" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="score" target="rep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f8" value="ta sama fabryka co api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;dashed=1;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="live" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Kolor = kto decyduje&lt;/b&gt;&lt;br&gt;niebieski: LLM · zielony: zwykły kod · pomarańczowy: stan wątku (checkpointy) · szary: wejście/wyjście, transport" style="text;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
    <diagram id="mcp-f5" name="7. MCP i asystent F5"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="940" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;MCP i końcowy asystent F5: serwer kovalo, klient, agent przez MCP, E5&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="s1" value="Asystent w docker compose (tools.source: mcp, mcp_transport: http)" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="500" height="24" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;ui: Chainlit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SSE: tool_start / tool_end / final&lt;br&gt;krok narzędzia „(przez MCP)”&lt;br&gt;„Wywołanie MCP: invocation_id”&lt;br&gt;pauzy akceptacji jak F3&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="220" height="130" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;api: CopilotService + graf&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;understand: assistant_understand_system&lt;br&gt;document_question → answer_documents&lt;br&gt;policy / approval → reguły MP3 (bez MCP)&lt;br&gt;tool_end: transport, invocation_id&lt;br&gt;stop_grace_period 200 s&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="260" height="140" as="geometry"/></mxCell><mxCell id="runner" value="&lt;b&gt;LazyAgentRunner → AgentRunner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;create_agent, agent_system (PINNED)&lt;br&gt;budżet 24 kroki / 180 s (PINNED)&lt;br&gt;middleware: tool_errors → fallback&lt;br&gt;→ CallMeter → StableUsage&lt;br&gt;(do modelu ToolMessage z artifact=None)&lt;br&gt;callbacki węzła (LangSmith pod turą)&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="270" height="160" as="geometry"/></mxCell><mxCell id="gem" value="&lt;b&gt;Gemini API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flash-Lite → Flash&lt;/font&gt;" style="ellipse;shape=cloud;fillColor=#ffffff;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="270" width="110" height="70" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;mcp_client: McpToolSource&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;jedno połączenie na proces api&lt;br&gt;nowe połączenie po błędzie transportu&lt;br&gt;check_record: rekord z TOOL_SPECS&lt;br&gt;przed wartościami domyślnymi&lt;br&gt;błędy: tool · protocol · transport · validation&lt;br&gt;limity mcp: 60 / 120 / 10 s (PINNED)&lt;/font&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="70" width="270" height="160" as="geometry"/></mxCell><mxCell id="srv" value="&lt;b&gt;mcp-server: FastMCP „kovalo”&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;7 narzędzi tylko do odczytu (readOnlyHint)&lt;br&gt;nakładki async: spec.make(ctx) w wątku&lt;br&gt;outputSchema = rekord, structuredContent&lt;br&gt;zasoby: kovalo://documents/{doc_id}&lt;br&gt;kovalo://policy/course-v1 · prompt supplier_review&lt;br&gt;/health: dane firmy, indeks&lt;/font&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1300" y="70" width="290" height="160" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;tools/ TOOL_SPECS (te same co F4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;company/ (OTIF, faktury, kara w groszach)&lt;br&gt;policy/check · search_documents (top_k 3)&lt;br&gt;check_termination_condition&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1300" y="290" width="290" height="90" as="geometry"/></mxCell><mxCell id="pgv" value="&lt;b&gt;pgvector&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kovalo_ctx&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=10;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1300" y="420" width="100" height="80" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;./data (ro)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;data/company/*&lt;br&gt;data/corpus/*&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1430" y="420" width="160" height="80" as="geometry"/></mxCell><mxCell id="saver" value="&lt;b&gt;postgres: checkpointy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;koperta agent_trace v1&lt;br&gt;zdarzenia z transport=mcp, invocation_id&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="240" height="100" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;inni klienci (stdio, własny proces)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Claude Code (.mcp.json: kovalo)&lt;br&gt;MCP Inspector · Claude Desktop&lt;br&gt;uv run kovalo-mcp --search memory&lt;br&gt;bez kluczy w środowisku&lt;/font&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="290" width="270" height="110" as="geometry"/></mxCell><mxCell id="e1" value="SSE" style="edgeStyle=orthogonalEd